DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Base64-encoded random secret. Generate with: openssl rand -base64 32
JWT_SECRET=YOUR_BASE64_JWT_SECRET
FRONTEND_URL=http://localhost:3000

# Optional locally; Render supplies PORT for a deployed web service.
PORT=8080
