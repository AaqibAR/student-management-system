# Server-only Spring Boot URL; browser requests use the Next.js API routes.
API_BASE_URL=http://localhost:8080

# Exact frontend origin, with no trailing slash. Set the deployed HTTPS origin
# in Vercel's Production environment; localhost is for local development only.
APP_ORIGIN=http://localhost:3000

# Older local setups can still use NEXT_PUBLIC_API_BASE_URL as a fallback.
# API_BASE_URL takes precedence. Never put secrets in NEXT_PUBLIC_ variables.
